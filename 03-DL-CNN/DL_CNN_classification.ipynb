    {
      "cell_type": "code",
      "source": [
        "data_augmentation = tf.keras.Sequential(\n",
        "    [\n",
        "        tf.keras.layers.RandomFlip(\n",
        "            mode=\"horizontal\",\n",
        "            seed=SEED\n",
        "        ),\n",
        "        tf.keras.layers.RandomRotation(\n",
        "            factor=0.05,\n",
        "            seed=SEED\n",
        "        ),\n",
        "        tf.keras.layers.RandomZoom(\n",
        "            height_factor=0.10,\n",
        "            width_factor=0.10,\n",
        "            seed=SEED\n",
        "        )\n",
        "    ],\n",
        "    name=\"data_augmentation\"\n",
        ")"
      ],
