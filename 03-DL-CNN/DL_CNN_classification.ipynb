      ],
      "source": [
        "valid_dataset = tf.keras.utils.image_dataset_from_directory(\n",
        "    VALID_DIR,\n",
        "    labels=\"inferred\",\n",
        "    label_mode=\"int\",\n",
        "    class_names=class_names,\n",
        "    image_size=IMAGE_SIZE,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    shuffle=False\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "e872f276-20aa-4251-8da7-bf5a079e4ec2",
      "metadata": {
