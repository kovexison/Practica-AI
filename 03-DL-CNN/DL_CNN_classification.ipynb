        "report_dictionary = classification_report(\n",
        "    y_true,\n",
        "    y_pred,\n",
        "    labels=np.arange(NUM_CLASSES),\n",
        "    target_names=class_names,\n",
        "    output_dict=True,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "class_metrics = pd.DataFrame(\n",
        "    report_dictionary\n",
        ").transpose()\n",
        "\n",
        "class_metrics = class_metrics.loc[\n",
        "    class_names,\n",
        "    [\n",
        "        \"precision\",\n",
        "        \"recall\",\n",
        "        \"f1-score\",\n",
        "        \"support\"\n",
        "    ]\n",
        "]\n",
        "\n",
        "top_3_best_classes = (\n",
        "    class_metrics\n",
        "    .sort_values(\n",
        "        by=[\n",
        "            \"f1-score\",\n",
        "            \"recall\",\n",
        "            \"precision\"\n",
        "        ],\n",
        "        ascending=False\n",
        "    )\n",
        "    .head(3)\n",
        ")\n",
        "\n",
        "print(\"Top-3 best performing classes:\")\n",
        "display(top_3_best_classes)"
      ],
