    {
      "cell_type": "code",
      "source": [
        "regularized_model = tf.keras.Sequential(\n",
        "    [\n",
        "        tf.keras.layers.Input(\n",
        "            shape=INPUT_SHAPE,\n",
        "            name=\"input_image\"\n",
        "        ),\n",
        "\n",
        "        data_augmentation,\n",
        "\n",
        "        # convolutional block 1\n",
        "        tf.keras.layers.Conv2D(\n",
        "            filters=32,\n",
        "            kernel_size=(3, 3),\n",
        "            padding=\"same\",\n",
        "            activation=\"relu\",\n",
        "            name=\"regularized_conv_1\"\n",
        "        ),\n",
        "        tf.keras.layers.MaxPooling2D(\n",
        "            pool_size=(2, 2),\n",
        "            name=\"regularized_pool_1\"\n",
        "        ),\n",
        "        tf.keras.layers.Dropout(\n",
        "            rate=0.25,\n",
        "            name=\"dropout_conv_1\"\n",
        "        ),\n",
        "\n",
        "        # convolutional block 2\n",
        "        tf.keras.layers.Conv2D(\n",
        "            filters=64,\n",
        "            kernel_size=(3, 3),\n",
        "            padding=\"same\",\n",
        "            activation=\"relu\",\n",
        "            name=\"regularized_conv_2\"\n",
        "        ),\n",
        "        tf.keras.layers.MaxPooling2D(\n",
        "            pool_size=(2, 2),\n",
        "            name=\"regularized_pool_2\"\n",
        "        ),\n",
        "        tf.keras.layers.Dropout(\n",
        "            rate=0.25,\n",
        "            name=\"dropout_conv_2\"\n",
        "        ),\n",
        "\n",
        "        # convolutional block 3\n",
        "        tf.keras.layers.Conv2D(\n",
        "            filters=128,\n",
        "            kernel_size=(3, 3),\n",
        "            padding=\"same\",\n",
        "            activation=\"relu\",\n",
        "            name=\"regularized_conv_3\"\n",
        "        ),\n",
        "        tf.keras.layers.MaxPooling2D(\n",
        "            pool_size=(2, 2),\n",
        "            name=\"regularized_pool_3\"\n",
        "        ),\n",
        "        tf.keras.layers.Dropout(\n",
        "            rate=0.25,\n",
        "            name=\"dropout_conv_3\"\n",
        "        ),\n",
        "\n",
        "        # convolutional block 4\n",
        "        tf.keras.layers.Conv2D(\n",
        "            filters=128,\n",
        "            kernel_size=(3, 3),\n",
        "            padding=\"same\",\n",
        "            activation=\"relu\",\n",
        "            name=\"regularized_conv_4\"\n",
        "        ),\n",
        "        tf.keras.layers.MaxPooling2D(\n",
        "            pool_size=(2, 2),\n",
        "            name=\"regularized_pool_4\"\n",
        "        ),\n",
        "        tf.keras.layers.Dropout(\n",
        "            rate=0.25,\n",
        "            name=\"dropout_conv_4\"\n",
        "        ),\n",
        "\n",
        "        # classification layers\n",
        "        tf.keras.layers.Flatten(\n",
        "            name=\"regularized_flatten\"\n",
        "        ),\n",
        "        tf.keras.layers.Dense(\n",
        "            units=128,\n",
        "            activation=\"relu\",\n",
        "            name=\"regularized_dense_hidden\"\n",
        "        ),\n",
        "        tf.keras.layers.Dropout(\n",
        "            rate=0.50,\n",
        "            name=\"dropout_dense\"\n",
        "        ),\n",
        "        tf.keras.layers.Dense(\n",
        "            units=NUM_CLASSES,\n",
        "            activation=\"softmax\",\n",
        "            name=\"regularized_class_probabilities\"\n",
        "        )\n",
        "    ],\n",
        "    name=\"regularized_car_parts_cnn\"\n",
        ")\n",
        "\n",
        "regularized_model.summary()"
      ],
