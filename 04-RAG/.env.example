# Copy this file to `.env` and fill in ONLY the provider you actually use.
# `.env` is git-ignored. NEVER commit real API keys.

# Which LLM provider the notebook should use: ollama | groq | gemini
LLM_PROVIDER=ollama

# --- Option A: Ollama (default, local, no key needed) ---
OLLAMA_MODEL=llama3.1

# --- Option B: Groq (free tier, no credit card) -> https://console.groq.com ---
# GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option C: Google Gemini (free tier) -> https://aistudio.google.com/apikey ---
# GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash
